.venv/
__pycache__/
*.pyc
.env
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
data/attachments/
data/backups/
data/reports/
# Runtime logs. They carry LAN addresses, connector ids and dead tunnel
# hostnames -- operational noise that has no business in the history of
# the code, and one of them was tracked by accident.
data/logs/
# Written by the AgentOps SDK into whatever directory the process started
# in. Operational noise, same as the rest.
agentops.log
# Migration packages: a plaintext copy of .env, the tunnel credentials
# and the whole database. Never committable (docs/30_VpsMigration.md).
data/migration/
frontend/node_modules/
frontend/dist/
.DS_Store
whatsapp-bridge/node_modules/
whatsapp-bridge/session/
whatsapp-bridge/.wwebjs_cache/

# TLS material for nginx -- real certs in production, self-signed
# locally. Never in git either way.
docker/certs/

# Cloudflare Tunnel credentials -- written by `cloudflared tunnel
# create`. This one file is the tunnel's identity: anyone holding it can
# serve traffic on the hostname. The config.yml beside it is tracked.
docker/cloudflared/credentials.json
# The live tunnel config: cloudflared cannot read the hostname from the
# environment, so it is literal in the file. config.example.yml ships in
# its place.
docker/cloudflared/config.yml
