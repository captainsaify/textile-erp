# Copy to .env and fill in real values. Never commit .env.
# See docs/16_Deployment.md §5 for the full secrets list and rotation notes.

ENVIRONMENT=local

# --- Postgres ---
POSTGRES_USER=sarfaraz
POSTGRES_PASSWORD=
POSTGRES_DB=textile_erp_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sarfaraz@localhost:5432/textile_erp_dev

# --- Redis ---
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SIGNING_KEY=change-me-to-a-random-256-bit-value
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- WhatsApp transport: "webjs" (whatsapp-web.js bridge, group-capable)
# or "meta" (official Business Cloud API) ---
WHATSAPP_TRANSPORT=webjs

# webjs transport: the Node relay in whatsapp-bridge/. Same secret goes
# to both processes; generate with `openssl rand -hex 24`.
BRIDGE_URL=http://localhost:3001
BRIDGE_SHARED_SECRET=

# meta transport (docs/08_WhatsApp.md, docs/14_Security.md §5)
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- AI intent classification (docs/09_AI.md) ---
ANTHROPIC_API_KEY=

# --- Backups (docs/16_Deployment.md §7) ---
BACKUP_ENCRYPTION_KEY=

# --- Attachments storage ---
ATTACHMENTS_DIR=./data/attachments
MAX_ATTACHMENT_SIZE_MB=15
