# Copy to .env and fill in real values. Never commit .env.
# See docs/16_Deployment.md §5 for the full secrets list and rotation notes.

ENVIRONMENT=local

# --- Postgres ---
POSTGRES_USER=sarfaraz
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-base64-32
POSTGRES_DB=textile_erp_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sarfaraz@localhost:5432/textile_erp_dev

# --- Redis ---
REDIS_PASSWORD=change-me-generate-with-openssl-rand-base64-32
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SIGNING_KEY=change-me-to-a-random-256-bit-value
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- WhatsApp transport: "webjs" (whatsapp-web.js bridge, group-capable)
# or "meta" (official Business Cloud API) ---
WHATSAPP_TRANSPORT=webjs

# webjs transport: the Node relay in whatsapp-bridge/. Same secret goes
# to both processes; generate with `openssl rand -hex 24`.
BRIDGE_URL=http://localhost:3001
BRIDGE_SHARED_SECRET=
# Optional (bridge process): restrict relaying to specific chats, e.g. the
# business group. Comma-separated web.js chat ids; the self-chat is always
# allowed. Group ids are printed by the bridge when it skips a group.
#BRIDGE_ALLOWED_CHATS=120363012345678901@g.us
# Optional (bridge process): browser binary; defaults to system Chrome.
#BRIDGE_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# meta transport (docs/08_WhatsApp.md, docs/14_Security.md §5)
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Public hostname: Cloudflare Tunnel (docs/16_Deployment.md §11) ---
# The UUID printed by `cloudflared tunnel create textile-erp`. Not a
# secret (the secret is docker/cloudflared/credentials.json), but it
# lives here so docker-compose.yml can interpolate it and nothing
# tracked in git has to be edited per machine.
CLOUDFLARE_TUNNEL_ID=
# The public hostname the tunnel answers on, e.g. erp.example.com. Also
# copy docker/cloudflared/config.example.yml to config.yml and put the
# same hostname there -- cloudflared cannot read it from the environment.
TUNNEL_HOSTNAME=
# Set this once the tunnel is created; it makes `docker compose up -d`
# include the cloudflared service. Left unset, the stack starts without
# a public entrance rather than crash-looping a tunnel it can't run.
#COMPOSE_PROFILES=tunnel

# --- Group broadcast (docs/22_GroupBroadcast.md) ---
# Meta's Cloud API cannot post to a WhatsApp group at all, so the group
# is reached through the outbound-only whatsapp-web.js relay. Both
# default to off: an unconfigured deployment simply never broadcasts,
# and no "Share to group" button is offered.
GROUP_CHAT_ID=
GROUP_BROADCAST_ENABLED=false

# --- OCR cost (docs/07_OCR.md §5b) ---
# Transcribing a table is a reading task, not a reasoning one. Haiku is
# roughly a fifth the cost per sheet of Opus; `python -m backend.cli
# ocr-compare --image <photo>` puts them side by side on a real sheet
# before you decide. Set empty to disable vision entirely and fall back
# to the local pipeline, which is free and less accurate.
VISION_MODEL=claude-haiku-4-5
OCR_USE_VISION=true

# --- AI intent classification (docs/09_AI.md) ---
ANTHROPIC_API_KEY=

# --- Vision tracing: AgentOps (backend/core/observability.py) ---
# Optional. Empty means no tracing and no behaviour change. Set it and
# every sheet read becomes a trace at app.agentops.ai carrying the
# prompt, model, tokens, latency and the transcription that came back.
# Note what that sends off the machine: the transcription is the sheet's
# contents -- supplier, invoice number, codes, amounts. The photo itself
# is not sent.
AGENTOPS_API_KEY=

# --- Backups (docs/16_Deployment.md §7) ---
BACKUP_ENCRYPTION_KEY=

# --- Attachments storage ---
ATTACHMENTS_DIR=./data/attachments
MAX_ATTACHMENT_SIZE_MB=15

# --- Worker concurrency (docs/30_VpsMigration.md §7) ---
# Each unit is a prefork child holding its own copy of the app: roughly
# 35MB for whatsapp, 50MB for scheduled. The defaults below are sized
# for a busy system; on a 2GB host, three people and a handful of
# messages an hour, they are the difference between 1.1GB and 750MB.
#   2GB host:  2 / 1 / 2      4GB+: leave unset
CELERY_WHATSAPP_CONCURRENCY=8
CELERY_OCR_CONCURRENCY=2
CELERY_SCHEDULED_CONCURRENCY=4
